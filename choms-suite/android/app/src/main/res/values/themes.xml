<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CHOMS" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/brand_light</item>
        <item name="colorOnPrimaryContainer">@color/brand_dark</item>
        <item name="colorSecondary">@color/sun</item>
        <item name="colorOnSecondary">@color/ink</item>
        <item name="colorTertiary">@color/coral</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorError">@color/danger</item>
        <item name="colorOutline">@color/line</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/brand_dark</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="materialButtonStyle">@style/Widget.CHOMS.Button</item>
        <item name="materialCardViewStyle">@style/Widget.CHOMS.Card</item>
    </style>

    <!-- Pill buttons -->
    <style name="Widget.CHOMS.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">28dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
    <style name="Widget.CHOMS.Button.Sun" parent="Widget.CHOMS.Button">
        <item name="backgroundTint">@color/sun</item>
        <item name="android:textColor">@color/ink</item>
    </style>
    <style name="Widget.CHOMS.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">28dp</item>
        <item name="android:textStyle">bold</item>
        <item name="strokeColor">@color/line</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <!-- Rounded cards -->
    <style name="Widget.CHOMS.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardElevation">2dp</item>
    </style>

    <!-- Rounded inputs -->
    <style name="Widget.CHOMS.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeColor">@color/brand</item>
    </style>
    <style name="Widget.CHOMS.TextInput.Dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeColor">@color/brand</item>
    </style>
</resources>
